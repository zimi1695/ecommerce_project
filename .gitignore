# ===== 数据文件（大文件，不入库，见 GitHub Release）=====
*.csv
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
*.gz

# 保留目录结构（忽略内容但不忽略目录本身）
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
env/

# ===== 环境与密钥 =====
.env
.env.*
*.pem
*.key

# ===== IDE =====
.idea/
.vscode/
*.swp
*.swo

# ===== Windows / macOS 系统文件 =====
*Zone.Identifier
Thumbs.db
Desktop.ini
.DS_Store

# ===== 构建产物 =====
dist/
build/
node_modules/
*.log
